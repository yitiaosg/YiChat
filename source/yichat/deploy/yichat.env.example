YICHAT_DATA=/var/lib/yichat/gateway
YICHAT_SITE=/root/yitiao
YICHAT_ORIGIN=https://chat.yitiao.org
YICHAT_SYNAPSE=http://127.0.0.1:8018
YICHAT_IDP_INTERNAL=http://127.0.0.1:5001
# Restore existing keys. Never rotate them as an upgrade or paste them into a client.
YICHAT_SESSION_KEY=
YICHAT_SYNAPSE_ADMIN_TOKEN=
# Generated by provision_archive.py; each DSN has its own PostgreSQL role.
YICHAT_ARCHIVE_READER_DSN=
YICHAT_ARCHIVE_INGEST_DSN=
YICHAT_ARCHIVE_PATH=/var/lib/yichat/archives
# Worker-only /etc/yichat/archive-worker.env:
# YICHAT_ARCHIVE_SEALER_DSN=
# YICHAT_ARCHIVE_CLEANUP_DSN=
# Actual treasury must match the existing yidt_core.OFFICIAL; no external RPC/private key.
YICHAT_OFFICIAL_WALLET=
YICHAT_FUNDS_ENABLED=false
YICHAT_UPLOAD_RATE=500000
YICHAT_UPLOAD_CONCURRENCY=3
YICHAT_DAILY_UPLOAD_BYTES=1073741824
YICHAT_PACKET_TTL_SECONDS=86400
YICHAT_TRANSFER_TTL_SECONDS=86400
# File bytes are fixed at 100000000, API requests fixed at 10/rolling second.
