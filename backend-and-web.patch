+                    form=parse_qs(r.content.decode());assert base64.urlsafe_b64encode(hashlib.sha256(form['code_verifier'][0].encode()).digest()).decode().rstrip('=')==q['code_challenge'][0]
+                    return httpx.Response(200,json={'id_token':encoded})
