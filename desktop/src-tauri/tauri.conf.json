{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YiChat",
  "version": "0.1.0",
  "identifier": "org.yitiao.yichat.desktop",
  "build": {
    "frontendDist": "../../source/yichat/client/dist",
    "beforeBuildCommand": "npm --prefix ../source/yichat/client ci --no-audit --no-fund && npm --prefix ../source/yichat/client run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "freezePrototype": false,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
